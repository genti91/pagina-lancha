# ---------------------------------------------------------------
# Google Sheets — destino de la lista de espera
# Instrucciones completas en SETUP-GOOGLE-SHEETS.md
# ---------------------------------------------------------------

# ID de la planilla: está en la URL, entre /d/ y /edit
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEET_ID=

# Email de la Service Account (termina en .iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Clave privada del JSON de la Service Account.
# Va entre comillas dobles y en UNA sola linea, con los saltos como \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------
# SEO
# ---------------------------------------------------------------

# Dominio publico, sin barra final. De aca salen las URLs canonicas,
# los hreflang, el sitemap y las tarjetas de Open Graph.
# Si queda mal, Google indexa el dominio equivocado.
NEXT_PUBLIC_SITE_URL=https://brouard-delta.vercel.app
